# Python
__pycache__/
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# macOS and Windows junk
.DS_Store
._*
Thumbs.db
desktop.ini

# Music and library data, anywhere in the repo
*.mp3
*.m4a
*.flac
*.wav
*.opus
*.ogg
*.webm
*.aac
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.musicorg/

# Reports and review exports, except the test data tables
*.csv
*.tsv
!engine/tests/data/*.csv
!engine/tests/data/*.tsv

# Secrets: keys, passwords and logins never belong in this public repo.
# scripts/check_secrets.py (the pre-commit hook) blocks these names too.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*
.netrc
.pypirc
credentials.json
client_secret*.json
# YouTube and YouTube Music logins (yt-dlp cookie files, ytmusicapi auth files)
cookies.txt
*cookies*.txt
*.cookies
browser.json
oauth.json
headers_auth.json
